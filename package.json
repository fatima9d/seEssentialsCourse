{
  "name": "se2",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint src",
    "clean": "if exist build rmdir /s /q build",
    "prebuild": "npm run clean && npm run lint",
    "build": "tsc",
    "postbuild": "powershell -Command \"$size=(Get-ChildItem -Recurse build | Measure-Object -Property Length -Sum).Sum; Write-Host ('finished build with size: ' + [math]::Round($size/1KB,2) + ' KB')\"",
    "prestart": "npm run build",
    "start": "node build/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "test": "jest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.1",
    "winston": "^3.19.0"
  }
}
